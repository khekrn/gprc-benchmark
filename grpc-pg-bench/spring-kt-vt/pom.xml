<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    spring-kt-vt: Spring Boot gRPC server + virtual threads + JetBrains Exposed
    DSL over blocking JDBC (HikariCP), written in KOTLIN.

    The Kotlin sibling of spring-vt, but the data layer is the Exposed DSL
    instead of hand-written SQL. Each unary RPC runs on a virtual thread
    (spring.threads.virtual.enabled=true plus the explicit VT executor in
    GrpcServerConfig) and drives Exposed's type-safe DSL through a HikariCP pool
    — HikariCP is still the pool, Exposed only the query layer. Blocking, on a
    virtual thread (the carrier parks on I/O); NOT coroutines, NOT R2DBC
    (spring-rt covers reactive, ktor-exposed covers Exposed+R2DBC). The gRPC
    stubs are the plain grpc-java StreamObserver/ImplBase generated by
    protoc-gen-grpc-java, called from Kotlin. Tuned harder for high concurrency
    (c=128) via the Netty/gRPC server knobs in GrpcServerConfig. Same gRPC
    contract; Exposed generates its own SQL (a framework-cost data point, not a
    byte-identical-SQL comparison — see Db.kt).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.beam.bench</groupId>
  <artifactId>spring-kt-vt-bench</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <!-- Bytecode target 21 (virtual threads); runs on the box's JDK 25.
         grpc-java, protobuf-java and the ascopes protobuf-maven-plugin
         versions are all managed by the Spring Boot 4.1 BOM. Kotlin 2.3.x is
         the first line that parses the JDK 25 version string (matches
         spring-rt). -->
    <java.version>21</java.version>
    <kotlin.version>2.3.0</kotlin.version>
    <!-- JetBrains Exposed (the data-access layer under test). 1.3.0 matches the
         version the ktor-exposed stack already uses; not managed by the Boot
         BOM, so pinned here. -->
    <exposed.version>1.3.0</exposed.version>
  </properties>

  <dependencies>
    <!-- Spring Boot 4.1 native gRPC server (Netty), Spring gRPC under it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-grpc-server</artifactId>
    </dependency>
    <!-- HikariCP DataSource autoconfig (Boot's default pool). Exposed binds to
         this same DataSource; we keep the starter for the pool + Boot wiring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JetBrains Exposed DSL over the JDBC backend (the layer under test),
         wired into Spring the official way (samples/exposed-spring, Boot 4):
         the boot4 starter brings exposed-core + exposed-spring-transaction and
         auto-configures a SpringTransactionManager over Boot's HikariCP
         DataSource; exposed-jdbc is the blocking transport. -->
    <dependency>
      <groupId>org.jetbrains.exposed</groupId>
      <artifactId>exposed-spring-boot4-starter</artifactId>
      <version>${exposed.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.exposed</groupId>
      <artifactId>exposed-jdbc</artifactId>
      <version>${exposed.version}</version>
    </dependency>
    <!-- Kotlin runtime (versions managed by the Boot BOM). -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <plugins>
      <!-- Generate Java protobuf + grpc-java stubs from src/main/proto.
           ONLY protoc-gen-grpc-java (no grpc-kotlin coroutine stubs) — we want
           the plain StreamObserver/ImplBase API called from Kotlin, mirroring
           spring-vt. Spring Boot 4.1's parent pre-configures the protoc version
           and the protoc-gen-grpc-java binary plugin, so no <configuration> is
           needed (same as spring-vt). -->
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <configuration>
          <args>
            <arg>-Xjsr305=strict</arg>
          </args>
          <compilerPlugins>
            <plugin>spring</plugin>
          </compilerPlugins>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-allopen</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>compile</id>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <goals>
              <goal>test-compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
